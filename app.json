{
  "expo": {
    "name": "OFriends",
    "slug": "ofriends",
    "version": "1.0.0",
    "scheme": "ofriends",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ofriends.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ofriends.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to let you share moments.",
          "cameraPermission": "This app needs camera access to capture moments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OFriends to access your camera to share Instants with friends."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OFriends to save Instants to your camera roll.",
          "savePhotosPermission": "Allow OFriends to save Instants to your camera roll.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131313",
          "image": "./assets/splash-logo.png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#131313",
            "image": "./assets/splash-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d83f006-7314-4668-9b27-5d630317026e"
      }
    }
  }
}
